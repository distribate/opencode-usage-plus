<Window x:Class="OpenCodeUsagePlus.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenCodeUsagePlus.Views"
        Title="OpenCode Usage Plus"
        Width="300" Height="360" MinHeight="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <StackPanel>

            <!-- Header -->
            <Grid Margin="12,9,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="OpenCode Usage Plus"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" />

                <ProgressBar Grid.Column="1"
                             Width="34" Height="3"
                             IsIndeterminate="True"
                             BorderThickness="0"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SubtleBrush}"
                             Background="{DynamicResource TrackBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        ToolTip="Settings"
                        Click="OnSettingsClick" />
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" />

            <!-- Usage -->
            <StackPanel Visibility="{Binding ShowUsage, Converter={StaticResource BoolToVisibility}}">

                <Grid Margin="12,9,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Rolling" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding RollingResetText}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RollingPercentText}"
                               FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
                <views:UsageBar Height="6" Margin="12,6,12,0"
                                Percent="{Binding RollingPercent}"
                                TrackBrush="{DynamicResource TrackBrush}" />

                <Grid Margin="12,12,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Weekly" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding WeeklyResetText}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding WeeklyPercentText}"
                               FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
                <views:UsageBar Height="6" Margin="12,6,12,0"
                                Percent="{Binding WeeklyPercent}"
                                TrackBrush="{DynamicResource TrackBrush}" />

                <Grid Margin="12,12,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Monthly" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding MonthlyResetText}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding MonthlyPercentText}"
                               FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
                <views:UsageBar Height="6" Margin="12,6,12,0"
                                Percent="{Binding MonthlyPercent}"
                                TrackBrush="{DynamicResource TrackBrush}" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="12,12,12,0" />

                <StackPanel Margin="12,8,12,0">
                    <Grid>
                        <TextBlock Text="Monthly history" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="24h" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="40" Margin="0,4,0,0">
                        <views:Sparkline Samples="{Binding History}"
                                         CurrentPercent="{Binding MonthlyPercent}"
                                         TrackBrush="{DynamicResource TrackBrush}" />
                        <TextBlock Text="Collecting history…"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowCollecting, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding WarningText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10" TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Border Height="10" />
            </StackPanel>

            <!-- Error (no data yet) -->
            <StackPanel Margin="12,12,12,14"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Loading -->
            <TextBlock Text="Loading usage…"
                       Margin="12,18"
                       HorizontalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Settings / first-run setup -->
            <StackPanel Margin="12,10,12,12"
                        Visibility="{Binding ShowSettingsPanel, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="API key (optional)" Style="{StaticResource CaptionText}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox"
                                 Height="26"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 PasswordChar="●"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    <Button Grid.Column="1"
                            Content="Save"
                            Margin="6,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnSaveApiKeyClick" />
                </Grid>

                <TextBlock Text="{Binding CredentialStatusText}"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock x:Name="ApiKeyFeedback"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="10" TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />

                <Button Content="Clear saved key"
                        Style="{StaticResource FlatButton}"
                        FontSize="11"
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Click="OnClearApiKeyClick" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,8" />

                <TextBlock Text="Tray icon" Style="{StaticResource CaptionText}" />
                <ComboBox x:Name="IconStyleCombo"
                          Height="26"
                          Margin="0,4,0,0"
                          SelectionChanged="OnIconStyleChanged">
                    <ComboBoxItem Content="Progress ring" />
                    <ComboBoxItem Content="Three bars" />
                    <ComboBoxItem Content="Bolt" />
                </ComboBox>

                <CheckBox x:Name="LaunchAtLoginCheck"
                          Content="Start with Windows"
                          Margin="0,10,0,0"
                          Foreground="{DynamicResource TextBrush}"
                          IsChecked="{Binding LaunchAtLogin}" />

                <CheckBox x:Name="NotificationsCheck"
                          Content="Notify at 80% and 95%"
                          Margin="0,6,0,0"
                          Foreground="{DynamicResource TextBrush}"
                          IsChecked="{Binding NotificationsEnabled}" />

                <Button Content="Open data folder"
                        Style="{StaticResource FlatButton}"
                        FontSize="11"
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Click="OnOpenDataFolderClick" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource DividerBrush}" />

            <!-- Footer -->
            <Grid Margin="8,5,8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Refresh" Style="{StaticResource FlatButton}" FontSize="11" Click="OnRefreshClick" />

                <TextBlock x:Name="VersionText"
                           Grid.Column="1"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2" Content="Quit" Style="{StaticResource FlatButton}" FontSize="11" Click="OnQuitClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
